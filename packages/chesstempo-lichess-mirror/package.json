{
  "name": "@userscripts/chesstempo-lichess-mirror",
  "private": true,
  "version": "0.1.23",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/strip-userscript-header.mjs",
    "test": "node --import tsx --test src/fen-diff.test.ts src/sync-parse.test.ts src/ct-orientation.test.ts",
    "verify:brave": "node scripts/verify-brave-cdp.mjs",
    "inspect:brave": "node scripts/inspect-brave-cdp.mjs",
    "tm:serve": "python3 -m http.server 8765 --directory dist",
    "tm:update": "node scripts/tm-update-brave-cdp.mjs",
    "cleanup:brave": "node scripts/brave-cdp-cleanup.mjs",
    "verify:e2e": "node scripts/verify-e2e-brave-cdp.mjs",
    "verify:e2e:black": "node scripts/verify-e2e-brave-cdp.mjs 'https://chesstempo.com/opening-training/repertoire/caro-kann-slav-2026.09.05' --orient-only",
    "test:drive": "pnpm build && node scripts/brave-cdp-cleanup.mjs && node scripts/tm-update-brave-cdp.mjs && node scripts/verify-e2e-brave-cdp.mjs",
    "verify:inject": "node scripts/verify-inject-ct.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "chessops": "^0.14.2"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vite-plugin-monkey": "^6.0.0"
  }
}
